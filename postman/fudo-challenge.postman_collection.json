          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Consulta cada medio segundo hasta que la solicitud sale de pending.",
                  "setTimeout(() => {}, 500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "  const data = pm.response.json().data;",
                  "  const attempts = (pm.environment.get('poll_attempts') || 0) + 1;",
                  "  if (data.status === 'pending' && attempts < 60) {",
                  "    pm.environment.set('poll_attempts', attempts);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "  } else {",
                  "    pm.environment.unset('poll_attempts');",
                  "    pm.test('Completada con su producto', () => {",
                  "      pm.expect(data.status).to.eql('completed');",
                  "      pm.expect(data.product_url).to.eql('/products/' + data.product_id);",
                  "    });",
                  "    pm.test('No antes de 5 segundos', () => {",
                  "      pm.expect(Date.now() - pm.environment.get('requested_at')).to.be.at.least(5000);",
                  "    });",
                  "    pm.environment.set('product_id', data.product_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
