# Copiá este archivo a .env solo si querés cambiar los valores por defecto de docker-compose.yml.
# Todas las variables tienen un valor por defecto que funciona, así que .env es opcional.

RACK_ENV=development
PORT=9292
PUMA_MAX_THREADS=5
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://fudo:fudo@db:5432/fudo-challenge
# Se usa en lugar de DATABASE_URL cuando RACK_ENV=test.
TEST_DATABASE_URL=postgres://fudo:fudo@db:5432/fudo-challenge-test
BCRYPT_COST=12
TOKEN_TTL_SECONDS=86400
LOG_LEVEL=info
