# Copy to .env only if you want to override the defaults in docker-compose.yml.
# Every variable has a working default, so .env is optional.

RACK_ENV=development
PORT=9292
PUMA_MAX_THREADS=5
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://fudo:fudo@db:5432/fudo-challenge
# Used instead of DATABASE_URL when RACK_ENV=test.
TEST_DATABASE_URL=postgres://fudo:fudo@db:5432/fudo-challenge-test
# bcrypt work factor: each +1 doubles the time to hash a password.
BCRYPT_COST=12
# debug, info, warn, error or fatal.
LOG_LEVEL=info
